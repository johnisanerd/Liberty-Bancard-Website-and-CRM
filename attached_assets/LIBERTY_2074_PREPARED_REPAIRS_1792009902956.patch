diff --git a/.github/workflows/c4-acceptance.yml b/.github/workflows/c4-acceptance.yml
new file mode 100644
index 0000000..0677ed6
--- /dev/null
+++ b/.github/workflows/c4-acceptance.yml
@@ -0,0 +1,71 @@
+name: C4 isolated acceptance
+
+on:
+  push:
+    branches: ['codex/2074-acceptance-*']
+
+permissions:
+  contents: read
+
+concurrency:
+  group: c4-acceptance-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  c4:
+    name: C4 / ${{ matrix.suite }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 25
+    strategy:
+      fail-fast: false
+      matrix:
+        suite:
+          - scripts/test-stage3-c4-actions.ts
+          - scripts/test-stage3-c4-browser.ts
+          - scripts/test-stage3-c4-health-browser.ts
+          - scripts/test-c2-contact-header.ts
+          - scripts/test-c2-postmerge-browser.ts
+          - scripts/test-toast-viewport-layout.mjs
+    env:
+      NODE_OPTIONS: --max-old-space-size=6144
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22.22.0'
+          cache: npm
+      - name: Install locked dependencies
+        run: |
+          test "$(node --version)" = v22.22.0
+          test "$(npm --version)" = 10.9.4
+          npm ci --include=dev --no-audit --no-fund
+      - name: Install private test infrastructure
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y postgresql-16 redis-server ripgrep
+          echo /usr/lib/postgresql/16/bin >> "$GITHUB_PATH"
+          chrome_bin="$(command -v google-chrome || command -v chromium || true)"
+          test -n "$chrome_bin"
+          sudo mkdir -p /repl/tools/bin
+          sudo ln -s "$chrome_bin" /repl/tools/bin/chromium
+      - name: Validate source contracts and manifest
+        run: |
+          node --import tsx scripts/test-stage3-c4-contracts.ts
+          node --import tsx scripts/ci-suite-manifest.ts --check
+      - name: Build this exact candidate
+        run: npm run build
+      - name: Execute exact suite on owned disposable resources
+        env:
+          C4_SELECTED_SUITE: ${{ matrix.suite }}
+        run: node --import tsx scripts/run-sfp2060-predeploy-disposable.ts --only "$C4_SELECTED_SUITE"
+      - name: Preserve evidence and failures
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: c4-${{ strategy.job-index }}-${{ github.sha }}
+          if-no-files-found: warn
+          path: |
+            docs/certification/stage3-c4/
+            docs/certification/stage3-c2/
+            dist/candidate-integrity.json
+            dist/sfp-publish-build.json
