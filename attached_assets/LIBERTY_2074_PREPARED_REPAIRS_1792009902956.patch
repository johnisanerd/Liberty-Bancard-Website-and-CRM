 import assert from "node:assert/strict";
+import express from "express";
 import {readFileSync} from "node:fs";
+// Exercise Express's actual ordered path matching without starting a server,
+// importing DB-bound routes, or treating it as authentication/SQL acceptance.
+const sequenceGetPaths = [...readFileSync("server/routes/campaigns.ts","utf8")
+  .matchAll(/app\.get\("(\/api\/sequences[^"\n]*)"/g)].map(match=>match[1]);
+function firstSequenceGetMatch(url:string) {
+  const router=express.Router();
+  let matched:string|undefined;
+  for(const path of sequenceGetPaths) router.get(path,(_req,res)=>{matched=path;res.end();});
+  router.handle({method:"GET",url,headers:{}} as any,{end(){}} as any,()=>{});
+  return matched;
+}
+assert.equal(firstSequenceGetMatch("/api/sequences/ab-test-results"),"/api/sequences/ab-test-results");
