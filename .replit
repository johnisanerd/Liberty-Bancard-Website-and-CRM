modules = ["nodejs-22", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["unzip", "zip", "redis"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3000

[env]
PORT = "5000"

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "RELEASE_SHA=$(cat dist/RELEASE_SHA 2>/dev/null || echo unset) npm run start"]
build = ["bash", "-c", "npm run build"]
ignorePorts = false

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-coverage"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "role-guards"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "seo-audit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pre-deploy"

[[workflows.workflow]]
name = "api-coverage"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/check-api-coverage.ts"

[[workflows.workflow]]
name = "role-guards"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/run-sfp2060-predeploy-disposable.ts --only scripts/smoke-role-guards.ts"

[[workflows.workflow]]
name = "seo-audit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/seo-audit.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "BACKGROUND_JOB_PROFILE=off npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "pre-deploy"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "RELEASE_SHA=$(git rev-parse HEAD) bash scripts/run-pre-deploy.sh"

[[workflows.workflow]]
name = "C1 isolated cloud preview"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/start-stage3-c1-cloud-preview.ts --reuse-build --public-port=6000"

[agent]
integrations = ["javascript_log_in_with_replit:2.0.0", "javascript_openai_ai_integrations:2.0.0", "google-docs:1.0.0", "google-drive:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

